{
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/rates",
      "destination": "https://api.frankfurter.app/latest?from=USD"
    },
    {
      "source": "/api-v2/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}