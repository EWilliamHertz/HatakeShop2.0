{
  "rewrites": [
    {
      "source": "/api/rates",
      "destination": "https://api.frankfurter.app/latest?from=USD"
    },
   {
      "source": "/api-v2/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}